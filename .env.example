# Server-only. Never prefix these with VITE_ (that would ship them to the browser), never log them, never commit .env.

# Resend API key (https://resend.com/api-keys), with sending access.
RESEND_API_KEY=

# The sender. Defaults to Resend's sandbox sender, "Ultravi0let <onboarding@resend.dev>", which only delivers to the
# address of your own Resend account. Once ultravi0let.com is verified in Resend, set a sender on it, for example:
# CONTACT_FROM_EMAIL=Ultravi0let <site@ultravi0let.com>
CONTACT_FROM_EMAIL=

# Where enquiries go. Defaults to hello@ultravi0let.com.
CONTACT_TO_EMAIL=
