# Server-only. Never prefix these with VITE_ (that would ship them to the browser), never log them, never commit .env.

# Resend API key (https://resend.com/api-keys). Needs "Sending access" for the verified ultravi0let.com domain.
RESEND_API_KEY=

# Where contact-form enquiries go. Optional: empty or unset means hello@ultravi0let.com.
CONTACT_TO=

# Optional: the sender. Until ultravi0let.com is verified in Resend, use Resend's sandbox sender for testing,
# e.g. "Ultravi0let website <onboarding@resend.dev>" (the sandbox only delivers to your own Resend account's address).
CONTACT_FROM=
